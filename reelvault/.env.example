# ==============================================================================
# REELVAULT — 100 DAYS OF FREE AI
# Environment Configuration
# ==============================================================================

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Service role key (used only in secure server-side environments)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL for redirects and production domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
